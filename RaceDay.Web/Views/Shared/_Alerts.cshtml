@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success d-flex align-items-start gap-2" role="status"><i class="bi bi-check-circle-fill"></i><div>@ok</div></div>
}
@if (TempData["Error"] is string bad)
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert"><i class="bi bi-exclamation-triangle-fill"></i><div>@bad</div></div>
}
@if (ViewData["Notice"] is string notice)
{
    <div class="alert alert-info d-flex align-items-start gap-2" role="status"><i class="bi bi-info-circle-fill"></i><div>@notice</div></div>
}
