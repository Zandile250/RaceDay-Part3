@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    // Use the stored name, not the posted form value (which is null when the user clears the box).
    var initials = Me.User!.Initials;
}
@await Html.PartialAsync("_PageHead", new PageHead("My profile", "Your details and profile picture."))

<div class="container py-4">
    <partial name="_Alerts" />

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="rd-card text-center">
                <div class="rd-card-body">
                    <div class="mb-3 d-flex justify-content-center">
                        @await Html.PartialAsync("_Avatar", new AvatarModel(Model.ProfilePictureUrl, initials, true, "Your profile picture"))
                    </div>
                    <h2 class="h4 mb-1">@Me.User!.FullName</h2>
                    <span class="rd-role-chip">@Model.Role</span>
                    <p class="text-muted small mt-2 mb-3">Member since @UiHelpers.DateShort(Model.MemberSince)</p>

                    <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" data-busy="Uploading…" class="text-start">
                        <label class="form-label" for="picture">Profile picture</label>
                        <input class="form-control" type="file" id="picture" name="picture" accept="image/jpeg,image/png,image/webp,image/gif"
                               data-max-mb="5" data-error="#picture-error" required />
                        <div class="form-text">JPG, PNG, WebP or GIF, up to 5 MB.</div>
                        <div id="picture-error" class="text-danger" role="alert"></div>
                        <button class="btn btn-outline-primary w-100 mt-3" type="submit"><i class="bi bi-upload"></i> Upload picture</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="rd-card">
                <div class="rd-card-head"><h2>Personal information</h2></div>
                <div class="rd-card-body">
                    <form asp-action="Update" method="post" data-busy="Saving…" novalidate>
                        <div asp-validation-summary="ModelOnly"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" autocomplete="name" />
                                <span asp-validation-for="FullName" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                                <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="email-ro">Email</label>
                                <input class="form-control" id="email-ro" value="@Model.Email" disabled />
                                <div class="form-text">Your email is your login, so it can't be changed here.</div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-4">Save changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
