@model CategoryFormViewModel
@{
    var action = (string)ViewData["FormAction"]!;
    var submit = (string)ViewData["SubmitLabel"]!;
}
<form method="post" action="@action" asp-antiforgery="true" data-busy="Saving…" novalidate>
    <div asp-validation-summary="ModelOnly"></div>
    <div class="mb-3">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control" placeholder="e.g. 10 km, 21 km or Under 20" />
        <span asp-validation-for="CategoryName" class="field-validation-error"></span>
    </div>
    <div class="row g-3">
        <div class="col-sm-4">
            <label asp-for="DistanceKm" class="form-label"></label>
            <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.1" max="999.99" />
            <span asp-validation-for="DistanceKm" class="field-validation-error"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="Price" class="field-validation-error"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="MaxParticipants" class="form-label"></label>
            <input asp-for="MaxParticipants" class="form-control" type="number" step="1" min="0" />
            <span asp-validation-for="MaxParticipants" class="field-validation-error"></span>
        </div>
    </div>
    <div class="form-text mt-2">Use 0 for a free entry or for no limit on field size.</div>
    <button type="submit" class="btn btn-primary mt-3">@submit</button>
    @if (ViewData["CancelUrl"] is string cancel)
    {
        <a class="btn btn-outline-secondary mt-3 ms-1" href="@cancel">Cancel</a>
    }
</form>
