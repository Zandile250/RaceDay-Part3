@model List<MyEnrolmentRow>
@{
    ViewData["Title"] = "My enrolments";
    var upcoming = Model.Where(r => r.EventDate is null || r.EventDate >= DateTime.Now).OrderBy(r => r.EventDate).ToList();
    var past = Model.Where(r => r.EventDate is not null && r.EventDate < DateTime.Now).OrderByDescending(r => r.EventDate).ToList();
}
@await Html.PartialAsync("_PageHead", new PageHead("My enrolments", "Every race you've entered, and where it stands."))

<div class="container py-4">
    <partial name="_Alerts" />

    @if (Model.Count == 0)
    {
        <div class="rd-card empty-state">
            <i class="bi bi-ticket-perforated"></i>
            <h3>You haven't enrolled in anything yet</h3>
            <p>Find an event you like and pick a category.</p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Browse upcoming events</a>
        </div>
    }
    else
    {
        @await Html.PartialAsync("_EnrolmentTable", (upcoming, "Upcoming", true))
        @if (past.Count > 0)
        {
            <div class="mt-4">@await Html.PartialAsync("_EnrolmentTable", (past, "Past events", false))</div>
        }
    }
</div>
