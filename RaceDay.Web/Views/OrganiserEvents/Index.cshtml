@model List<EventDto>
@{
    ViewData["Title"] = "My events";
}
@await Html.PartialAsync("_PageHead", new PageHead("My events", "Create, edit and manage the events you organise."))

<div class="container py-4">
    <partial name="_Alerts" />

    <div class="rd-card">
        <div class="rd-card-head">
            <h2>All events</h2>
            <a class="btn btn-primary btn-sm" asp-action="Create"><i class="bi bi-plus-lg"></i> New event</a>
        </div>
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-calendar-plus"></i>
                <h3>No events yet</h3>
                <p>Create an event to get started.</p>
                <a class="btn btn-primary" asp-action="Create">Create an event</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table rd-table">
                    <thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Distance</th><th class="text-end">Manage</th></tr></thead>
                    <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>
                                <a class="fw-semibold" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a>
                                <div class="small text-muted"><i class="bi bi-geo-alt-fill text-primary"></i> @e.Location</div>
                            </td>
                            <td>@UiHelpers.DateShort(e.EventDate)<div class="small text-muted">@UiHelpers.Countdown(e.EventDate)</div></td>
                            <td><i class="bi @UiHelpers.TypeIcon(e.EventType) text-primary"></i> @e.EventType</td>
                            <td>@UiHelpers.Km(e.DistanceKm)</td>
                            <td class="text-end">
                                <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@e.EventId" title="Edit"><i class="bi bi-pencil"></i> Edit</a>
                                    <a class="btn btn-outline-secondary btn-sm" asp-controller="OrganiserCategories" asp-action="Index" asp-route-eventId="@e.EventId" title="Categories"><i class="bi bi-tags"></i></a>
                                    <a class="btn btn-outline-secondary btn-sm" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@e.EventId" title="Enrolments"><i class="bi bi-people"></i></a>
                                    <a class="btn btn-outline-secondary btn-sm" asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@e.EventId" title="Results"><i class="bi bi-stopwatch"></i></a>
                                    <form asp-action="Delete" asp-route-id="@e.EventId" method="post" data-confirm="Delete “@e.EventName”? This can't be undone.">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
